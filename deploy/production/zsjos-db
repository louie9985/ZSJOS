#!/usr/bin/env bash
set -euo pipefail

DEPLOY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${ZSJOS_ENV_FILE:-$DEPLOY_DIR/.env}"
COMPOSE_FILE="$DEPLOY_DIR/compose.database.yml"
OVERRIDE_FILE="${ZSJOS_DB_COMPOSE_OVERRIDE:-$DEPLOY_DIR/compose.override.yml}"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "Missing $ENV_FILE; create it from .env.example and create the referenced secret files." >&2
  exit 1
fi

COMPOSE_FLAGS=(-f "$COMPOSE_FILE")
if [[ -f "$OVERRIDE_FILE" ]]; then
  COMPOSE_FLAGS+=(-f "$OVERRIDE_FILE")
fi

docker compose --env-file "$ENV_FILE" "${COMPOSE_FLAGS[@]}" run --rm db-migrator "$@"
