COMPOSE_PROJECT_NAME=zsjos
MYSQL_IMAGE=mysql:8
REDIS_IMAGE=redis:7-alpine
ZSJOS_DB_MIGRATOR_IMAGE=zsjos-db-migrator:local

ZSJOS_DB_NAME=zsjos
ZSJOS_DB_HOST=mysql
ZSJOS_DB_PORT=3306
ZSJOS_DB_MIGRATION_USER=zsjos_migrator
ZSJOS_DB_APP_USER=zsjos_app
ZSJOS_DB_RELEASE_VERSION=development
# Comma-separated release manifest. Optional modules are never enabled by file presence alone.
ZSJOS_DB_MODULES=core
ZSJOS_DB_BACKUP_DIR=/backups

# Create these files with at least 24 URL-safe characters. The secrets directory is ignored by Git.
MYSQL_ROOT_PASSWORD_FILE=./secrets/mysql-root-password
MYSQL_MIGRATION_PASSWORD_FILE=./secrets/mysql-migration-password
MYSQL_APP_PASSWORD_FILE=./secrets/mysql-app-password
