#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"

if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  echo "Python 3 is required to run zsjos-db." >&2
  exit 127
fi

exec "$PYTHON_BIN" "$ROOT_DIR/script/sql/mysql/tools/zsjos_db.py" "$@"
