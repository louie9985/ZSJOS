<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="https://zsjos.com/bpm">
  <process id="zsjos_student_contact_extension" name="学员联系延期审批" isExecutable="true">
    <startEvent id="StartEvent" name="提交延期申请"/>
    <sequenceFlow id="flow_start_review" sourceRef="StartEvent" targetRef="deliverySupervisorReview"/>
    <userTask id="deliverySupervisorReview" name="教务主管审批" flowable:assignee="${assignee}">
      <extensionElements>
        <flowable:candidateStrategy>35</flowable:candidateStrategy>
        <flowable:approveType>1</flowable:approveType>
        <flowable:approveMethod>3</flowable:approveMethod>
        <flowable:reasonRequire>true</flowable:reasonRequire>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${coll_userList}" flowable:elementVariable="assignee">
        <completionCondition xsi:type="tFormalExpression"><![CDATA[${nrOfCompletedInstances > 0}]]></completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>
    <sequenceFlow id="flow_review_end" sourceRef="deliverySupervisorReview" targetRef="EndEvent"/>
    <endEvent id="EndEvent" name="完成"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_zsjos_student_contact_extension">
    <bpmndi:BPMNPlane id="BPMNPlane_zsjos_student_contact_extension" bpmnElement="zsjos_student_contact_extension">
      <bpmndi:BPMNShape id="Shape_StartEvent" bpmnElement="StartEvent">
        <omgdc:Bounds x="120" y="150" width="36" height="36"/>
        <bpmndi:BPMNLabel><omgdc:Bounds x="95" y="193" width="86" height="20"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_deliverySupervisorReview" bpmnElement="deliverySupervisorReview">
        <omgdc:Bounds x="250" y="118" width="180" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent" bpmnElement="EndEvent">
        <omgdc:Bounds x="550" y="150" width="36" height="36"/>
        <bpmndi:BPMNLabel><omgdc:Bounds x="550" y="193" width="36" height="20"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_flow_start_review" bpmnElement="flow_start_review">
        <omgdi:waypoint x="156" y="168"/><omgdi:waypoint x="250" y="168"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_review_end" bpmnElement="flow_review_end">
        <omgdi:waypoint x="430" y="168"/><omgdi:waypoint x="550" y="168"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
