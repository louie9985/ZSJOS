# 必填。租户 ID 由部署环境提供，页面不会在源码中猜测或回退。
VITE_MEDIA_SCREEN_TENANT_ID=1

# 生产通常留空，让浏览器请求同源 /public-api，由部署层转发到 ZSJOS 后端。
VITE_MEDIA_SCREEN_API_BASE_URL=
VITE_MEDIA_SCREEN_API_PREFIX=/public-api/zsjos/media-screen

# 仅供本地 Vite 开发代理使用。
VITE_MEDIA_SCREEN_BACKEND_TARGET=http://192.168.2.17:48080

# 仅在 npm run dev 且显式为 true 时生效；生产构建始终禁用。
VITE_MEDIA_SCREEN_ENABLE_MOCK=false
